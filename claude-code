#!/usr/bin/env bash
# claude-code — Launch Claude Code through the free-claude-code proxy.
# Starts the proxy server on demand, then runs `claude` pointed at it.
#
# Usage:
#   claude-code               — start proxy (if down) and launch Claude Code
#   claude-code [claude args] — pass any args straight through to claude
#   claude-code server status — show proxy status
#   claude-code server start  — start the proxy server (idempotent)
#   claude-code server stop   — stop the proxy server
#   claude-code server log    — tail the proxy server log
#   claude-code help, -h, --help
#
# Env overrides:
#   FCC_DIR    repo path                       (default ~/Projects/tools/free-claude-code)
#   FCC_HOST   proxy bind/host                 (default 127.0.0.1)
#   FCC_PORT   proxy port                      (default 8082)
#   FCC_TOKEN  ANTHROPIC_AUTH_TOKEN            (default freecc)
#   FCC_LOG    server log file                 (default /tmp/fcc_server.log)

set -euo pipefail

FCC_DIR="${FCC_DIR:-$HOME/Projects/tools/free-claude-code}"
FCC_HOST="${FCC_HOST:-127.0.0.1}"
FCC_PORT="${FCC_PORT:-8082}"
FCC_TOKEN="${FCC_TOKEN:-freecc}"
FCC_LOG="${FCC_LOG:-/tmp/fcc_server.log}"
FCC_URL="http://${FCC_HOST}:${FCC_PORT}"

# ── Colours ───────────────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; DIM='\033[2m'; RESET='\033[0m'

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
  echo ""
  echo -e "  ${BOLD}${CYAN}claude-code — free-claude-code launcher${RESET}"
  echo ""
  echo -e "  ${BOLD}USAGE${RESET}"
  echo -e "    claude-code ${DIM}[claude args...]${RESET}"
  echo -e "    claude-code ${DIM}server {status|start|stop|log}${RESET}"
  echo ""
  echo -e "  ${BOLD}EXAMPLES${RESET}"
  echo -e "    ${DIM}\$${RESET} claude-code                     ${DIM}# start proxy + run Claude Code${RESET}"
  echo -e "    ${DIM}\$${RESET} claude-code -p 'fix this bug'   ${DIM}# pass args to Claude Code${RESET}"
  echo -e "    ${DIM}\$${RESET} claude-code server status       ${DIM}# is the proxy up?${RESET}"
  echo ""
  echo -e "  ${BOLD}CONFIG${RESET}"
  echo -e "    ${DIM}FCC_DIR, FCC_HOST, FCC_PORT, FCC_TOKEN, FCC_LOG (env overrides)${RESET}"
  echo ""
  exit 0
}

# ── Server helpers ────────────────────────────────────────────────────────────
server_status() {
  if curl -fsS --max-time 2 "${FCC_URL}/health" >/dev/null 2>&1; then
    echo -e "  ${GREEN}● Proxy up${RESET}   ${BOLD}${FCC_URL}${RESET}"
    return 0
  fi
  echo -e "  ${RED}● Proxy down${RESET}  ${FCC_URL}"
  return 1
}

server_pid() {
  ss -tlnp 2>/dev/null | grep ":${FCC_PORT} " | grep -oP 'pid=\K[0-9]+' | head -1
}

server_start() {
  if curl -fsS --max-time 2 "${FCC_URL}/health" >/dev/null 2>&1; then
    echo -e "  ${GREEN}✔ Proxy already running.${RESET} ${FCC_URL}"
    return 0
  fi
  if [[ ! -d "$FCC_DIR" ]]; then
    echo -e "  ${RED}✗ free-claude-code not found:${RESET} $FCC_DIR" >&2
    echo -e "  ${YELLOW}  Set FCC_DIR to the repo location.${RESET}" >&2
    return 1
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo -e "  ${RED}✗ uv not found — install it first (https://astral.sh/uv).${RESET}" >&2
    return 1
  fi
  echo -e "  ${YELLOW}⟳ Starting proxy server...${RESET} ${FCC_URL}"
  (
    cd "$FCC_DIR"
    nohup uv run uvicorn server:app --host "$FCC_HOST" --port "$FCC_PORT" >"$FCC_LOG" 2>&1 &
  ) >/dev/null 2>&1
  disown 2>/dev/null || true

  for _ in $(seq 1 30); do
    if curl -fsS --max-time 2 "${FCC_URL}/health" >/dev/null 2>&1; then
      echo -e "  ${GREEN}✔ Proxy up.${RESET} ${FCC_URL} ${DIM}(log: $FCC_LOG)${RESET}"
      return 0
    fi
    sleep 1
  done
  echo -e "  ${RED}✗ Proxy failed to start.${RESET} Last log lines:" >&2
  tail -5 "$FCC_LOG" >&2 || true
  return 1
}

server_stop() {
  local pid
  pid="$(server_pid || true)"
  if [[ -z "$pid" ]]; then
    echo -e "  ${YELLOW}● Proxy not running.${RESET}"
    return 0
  fi
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 10); do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo -e "  ${GREEN}✔ Proxy stopped (pid $pid).${RESET}"
      return 0
    fi
    sleep 1
  done
  kill -9 "$pid" 2>/dev/null || true
  echo -e "  ${GREEN}✔ Proxy killed (pid $pid).${RESET}"
}

# ── Server subcommand ─────────────────────────────────────────────────────────
if [[ "${1:-}" == "server" ]]; then
  shift
  case "${1:-status}" in
    status) server_status; exit $? ;;
    start)  server_start ;;
    stop)   server_stop ;;
    log)    tail -f "$FCC_LOG" ;;
    *)      echo -e "  ${RED}✗ Unknown server command:${RESET} ${1:-}" >&2; show_help ;;
  esac
  exit $?
fi

# ── Help ──────────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "help" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  show_help
fi

# ── Ensure proxy is running ───────────────────────────────────────────────────
if ! curl -fsS --max-time 2 "${FCC_URL}/health" >/dev/null 2>&1; then
  server_start
fi

# ── Launch Claude Code ────────────────────────────────────────────────────────
if ! command -v claude >/dev/null 2>&1; then
  echo -e "  ${RED}✗ claude CLI not found.${RESET} Install it:" >&2
  echo -e "      npm install -g @anthropic-ai/claude-code" >&2
  exit 1
fi

export ANTHROPIC_AUTH_TOKEN="${FCC_TOKEN}"
export ANTHROPIC_BASE_URL="${FCC_URL}"
# Skip Claude Code's OAuth login screen — the proxy is the API.
unset ANTHROPIC_API_KEY 2>/dev/null || true

echo -e "  ${DIM}→ ${BOLD}claude${RESET} ${DIM}via ${CYAN}${FCC_URL}${RESET}" >&2
exec claude "$@"
